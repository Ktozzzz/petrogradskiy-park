POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=parks
POSTGRES_PORT=5432

# Строка подключения backend (psycopg)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/parks

# AI-слой: любой OpenAI-совместимый endpoint (Ollama, vLLM, OpenAI, Groq)
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen2.5:3b
AI_TIMEOUT=30
# Ключ нужен хостинговым провайдерам (Groq/OpenAI/OpenRouter); у локального
# Ollama — оставить пустым. В репозиторий не записывать, только в окружение.
AI_API_KEY=

# Внешний геокодер (Location Resolver: собственная БД -> геокодер)
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_ENABLED=true

# Веса гибридного ранжирования рекомендаций
RANK_WEIGHT_SEMANTIC=0.50
RANK_WEIGHT_SPATIAL=0.30
RANK_WEIGHT_CATEGORY=0.20

# Карта
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Ограничения API
MAX_RADIUS_METERS=5000
MAX_LIMIT=100
DEFAULT_LIMIT=20

# Целевая область и интерфейс
BOROUGH=Петроградский
FRONTEND_DIST=frontend/dist
LOG_LEVEL=INFO

APP_PORT=8000
FRONTEND_PORT=5173
